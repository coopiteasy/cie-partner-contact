<odoo>
    <record model="ir.module.category" id="module_category_social_service">
        <field name="name">Social Service</field>
        <field name="exclusive" eval="0" />
        <field name="sequence">53</field>
    </record>
    <record id="group_portal_social_partner" model="res.groups">
        <field name="name">Partner Portal Group</field>
        <field name="category_id" ref="base.module_category_website" />
        <field
            name="comment"
        >Group to restrict access to pages only to partners with the social_type social_partner.</field>
    </record>
    <record id="group_access_social_beneficiary" model="res.groups">
        <field name="name">Access Beneficiary Informations Group</field>
        <field
            name="category_id"
            ref="partner_social_service.module_category_social_service"
        />
        <field
            name="comment"
        >Group for users with the permission to access beneficiaries informations.</field>
    </record>
</odoo>
