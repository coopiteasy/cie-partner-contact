<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.social.service</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="social_type" />
                <field
                    name="is_social_benefactor"
                    invisible="social_type != 'accompagner'"
                />
                <field
                    name="is_social_employee"
                    invisible="social_type != 'accompagner'"
                />
                <field
                    name="is_social_volunteer"
                    invisible="social_type != 'accompagner'"
                />
            </xpath>
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='misc']"
                position="inside"
            >
                <field name="social_file_creation_date" widget="date" />
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page
                    name='beneficiary'
                    string="Beneficiary"
                    invisible="social_type != 'beneficiary'"
                    groups="partner_social_service.group_access_social_beneficiary"
                >
                    <group>
                        <field name="social_partner_ids" widget="many2many_tags" />
                        <field
                            name="social_beneficiary_properties"
                            widget="properties"
                        />
                    </group>
                </page>
                <page
                    name='volunteer'
                    string="Volunteer"
                    invisible="social_type != 'accompagner' or not is_social_volunteer"
                >
                    <group>
                        <field name="social_volunteer_properties" widget="properties" />
                    </group>
                </page>
                <page
                    name='partner'
                    string="Partner"
                    invisible="social_type != 'partner'"
                >
                    <group>
                        <field name="social_beneficiary_ids" widget="many2many_tags" />
                        <field name="social_partner_properties" widget="properties" />
                    </group>
                </page>
                <page
                    name='benefactor'
                    string="Benefactor"
                    invisible="social_type != 'accompagner' or not is_social_benefactor"
                >
                    <group>
                        <field
                            name="social_benefactor_properties"
                            widget="properties"
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus" />
            </xpath>
        </field>
    </record>
</odoo>
