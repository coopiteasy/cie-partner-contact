<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.social.service</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="social_type" />
                <field
                    name="is_social_benefactor"
                    invisible="social_type != 'accompagner'"
                />
                <field
                    name="is_social_employee"
                    invisible="social_type != 'accompagner'"
                />
                <field
                    name="is_social_volunteer"
                    invisible="social_type != 'accompagner'"
                />
            </xpath>
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='misc']"
                position="inside"
            >
                <field name="social_file_creation_date" widget="date" />
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page
                    name='beneficiary'
                    string="Beneficiary"
                    invisible="social_type != 'beneficiary'"
                    groups="partner_social_service.group_access_social_beneficiary"
                >
                    <group>
                        <field name="social_partner_ids" widget="many2many_tags" />
                        <field
                            name="social_beneficiary_properties"
                            widget="properties"
                        />
                    </group>
                    <group string="Beneficiary Information">
                        <field name="social_beneficiary_orientation_id" />
                        <field name="social_beneficiary_gdpr" />
                        <field name="social_beneficiary_spoken_language" />
                        <field name="social_beneficiary_residence_permit_title_id" />
                        <field name="social_beneficiary_contact_person_name" />
                        <field name="social_beneficiary_contact_person_mobile" />
                        <field name="social_beneficiary_marital_status_id" />
                        <field name="social_beneficiary_children_count" />
                        <field name="social_beneficiary_household_type_id" />
                        <field name="social_beneficiary_resource_id" />
                        <field name="social_beneficiary_belgium_since_date" />
                        <field name="social_beneficiary_residence_right_id" />
                    </group>
                </page>
                <page
                    name='volunteer'
                    string="Volunteer"
                    invisible="social_type != 'accompagner' or not is_social_volunteer"
                >
                    <group>
                        <field name="social_volunteer_properties" widget="properties" />
                    </group>
                    <group string="Volunteer Information">
                        <field name="social_volunteer_professional_status_id" />
                        <field name="social_volunteer_personal_email" />
                        <field name="social_volunteer_nationality_country_id" />
                        <field name="social_volunteer_contact_method_id" />
                        <field
                            name="social_volunteer_type_ids"
                            widget="many2many_tags"
                        />
                        <field
                            name="social_volunteer_motivation_ids"
                            widget="many2many_tags"
                        />
                    </group>
                    <group string="Volunteer Course">
                        <field
                            name="social_volunteer_course_ids"
                            colspan="2"
                            nolabel="1"
                        >
                            <list editable="bottom">
                                <field name="date" />
                                <field name="volunteer_type_id" />
                                <field name="reason" />
                            </list>
                        </field>
                    </group>
                </page>
                <page
                    name='partner'
                    string="Partner"
                    invisible="social_type != 'partner'"
                >
                    <group>
                        <field name="social_beneficiary_ids" widget="many2many_tags" />
                        <field name="social_partner_properties" widget="properties" />
                    </group>
                    <group string="Partner Information">
                        <field name="social_partner_structure_id" />
                    </group>
                </page>
                <page
                    name='benefactor'
                    string="Benefactor"
                    invisible="social_type != 'accompagner' or not is_social_benefactor"
                >
                    <group>
                        <field
                            name="social_benefactor_properties"
                            widget="properties"
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus" />
            </xpath>
        </field>
    </record>
</odoo>
